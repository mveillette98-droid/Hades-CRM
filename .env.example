# Supabase — get these from your Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Service role key for server-side admin actions.
# Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API key for the agent team (research, cold email, content, critic).
# Get one at https://console.anthropic.com. Server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model the agents run on. Defaults to claude-opus-5-5.
# CADENCE_AGENT_MODEL=claude-opus-5-5

# Encrypts the sending inboxes' app passwords. Any long random string, e.g.
# `openssl rand -base64 32`. Keep it safe: lose it and you re-enter the passwords.
CADENCE_SECRET_KEY=

# Optional: Apollo.io API key, for finding contacts by title, location and
# company size on a client's Contacts page. Settings > Integrations > API.
APOLLO_API_KEY=

# Optional: MillionVerifier API key, for verifying emails before they go
# into a campaign. Under $1 per 500 emails.
MILLIONVERIFIER_API_KEY=
